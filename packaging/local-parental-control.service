[Unit]
Description=Local Parental Control
Documentation=file:/usr/share/doc/local-parental-control/README.md
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/local-parental-control
Restart=on-failure
RestartSec=5s
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/local-parental-control /run/local-parental-control
RuntimeDirectory=local-parental-control
RuntimeDirectoryMode=0700
StateDirectory=local-parental-control
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target

